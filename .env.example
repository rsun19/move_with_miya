# ──────────────────────────────────────────
# Move with Miya — Environment Variables
# ──────────────────────────────────────────

# ─── Postgres ─────────────────────────────
POSTGRES_USER=miya
POSTGRES_PASSWORD=miya
POSTGRES_DB=miya

# Service-specific database URLs
USER_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5432/miya_users
CLASSES_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5432/miya_classes
REGISTRATION_SERVICE_DATABASE_URL=postgresql://miya:miya@localhost:5432/miya_registrations

# ─── RabbitMQ ─────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── Redis (session store) ────────────────
REDIS_URL=redis://localhost:6379

# ─── Session ──────────────────────────────
SESSION_SECRET=change-me-to-a-random-string

# ─── Google OAuth ─────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ─── CORS ─────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── General ──────────────────────────────
NODE_ENV=development

# ─── Frontend ──────────────────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:3001/auth/google
